// Cloudflare Worker config: the one production Worker, also used by `wrangler dev` and the tests
// (locally D1 is simulated, so the database id below only matters on Cloudflare).
// Deploy walkthrough: docs/SELF_HOSTING.md. Secrets are never stored here.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "veilauth",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "minify": true,
  // The Worker serves the web client (apps/web, built into ../web/dist); only /api/* runs Worker
  // code first (same origin, no CORS). Security headers for the app are in apps/web/public/_headers.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    // Optional (D-049): a Turnstile site key protects sign-up; empty turns it off.
    "TURNSTILE_SITE_KEY": "",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "veilauth",
      // Id of the production D1 database (Dashboard → Storage & Databases → D1).
      "database_id": "67298de0-a172-4846-ac07-d9acc18dacf1",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "4201", "simple": { "limit": 5, "period": 60 } },
  ],
}
