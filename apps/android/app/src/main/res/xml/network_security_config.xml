<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system CAs only (no user-installed CAs). The API host is additionally pinned in
     code (OkHttp CertificatePinner, D-047). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
