    "openapi": "tsc -p tsconfig.build.json && node dist/generate-openapi.js",
    "openapi:check": "tsc -p tsconfig.build.json && node dist/generate-openapi.js --check"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
